#!/bin/bash
# Flash TangCore firmware to a Tang Console's BL616 from Linux (any arch).
#
#   tangcore-flash                 newest CI build of the current branch
#   tangcore-flash --ref BRANCH    newest CI build of BRANCH
#   tangcore-flash --run RUN_ID    a specific CI run
#   tangcore-flash --file FW.bin   a local file
#   options: --board console138k|console60k (default console138k)
#
# Waits for the BL616's ROM flashing mode ("Bouffalo CDC", 349b:6160), then
# writes only the TangCore image at 0x40000; Sipeed's image at 0x0 is never
# touched. Needs gh (logged in) and bflb-eflash-loader (bflb-mcu-tool).
set -euo pipefail

REPO=cassiostp/firmware-bl616
BOARD=console138k
REF= RUN= FILE=
while [ $# -gt 0 ]; do
  case "$1" in
    --board) BOARD=$2; shift 2 ;;
    --ref) REF=$2; shift 2 ;;
    --run) RUN=$2; shift 2 ;;
    --file) FILE=$(realpath -- "$2"); shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$FILE" ]; then
  if [ -z "$RUN" ]; then
    if [ -z "$REF" ]; then
      REF=$(git -C "$(dirname "$(realpath "$0")")" branch --show-current 2>/dev/null || true)
      REF=${REF:-master}
    fi
    RUN=$(gh run list -R "$REPO" --workflow build --branch "$REF" --status success \
          --limit 1 --json databaseId -q '.[0].databaseId')
    [ -n "$RUN" ] || { echo "no successful build for $REF" >&2; exit 1; }
  fi
  DIR=${XDG_CACHE_HOME:-$HOME/.cache}/tangcore-flash/$RUN
  if [ ! -f "$DIR/tangcore_$BOARD.bin" ]; then
    mkdir -p "$DIR"
    gh run download "$RUN" -R "$REPO" -n "tangcore-$BOARD" -D "$DIR"
  fi
  FILE=$DIR/tangcore_$BOARD.bin
  echo "Firmware: $FILE (run $RUN${REF:+, $REF})"
fi
[ "$(head -c 4 "$FILE")" = "BFNP" ] || { echo "$FILE is not a BL616 image" >&2; exit 1; }

find_port() {
  for d in /sys/class/tty/ttyACM*; do
    [ -e "$d" ] || continue
    local dev=$(readlink -f "$d/device/..")
    if [ "$(cat "$dev/idVendor" 2>/dev/null)" = 349b ] && [ "$(cat "$dev/idProduct" 2>/dev/null)" = 6160 ]; then
      echo "/dev/$(basename "$d")"; return
    fi
  done
}

PORT=$(find_port)
if [ -z "$PORT" ]; then
  echo
  echo "Waiting for the board in flashing mode. On the console, either:"
  echo "  - with TangCore running and this PC plugged into the BL616 USB-C port:"
  echo "    Options -> Flash mode... -> Restart in flash mode, or"
  echo "  - hold BOOT while plugging this PC into the BL616 USB-C port."
  for _ in $(seq 300); do
    PORT=$(find_port); [ -n "$PORT" ] && break; sleep 1
  done
  [ -n "$PORT" ] || { echo "board not found after 5 minutes" >&2; exit 1; }
  sleep 1
fi
echo "Board found on $PORT, flashing..."
bflb-eflash-loader --chipname bl616 -p "$PORT" --write --flash --addr 0x40000 --file "$FILE" \
  > /tmp/tangcore-flash.log 2>&1 || true
if grep -q 'All Successful' /tmp/tangcore-flash.log; then
  grep 'sha256 caled by dev' /tmp/tangcore-flash.log | sed 's/.*- /verified: /'
  echo "Done. Unplug the PC, then power the console as usual."
else
  tail -20 /tmp/tangcore-flash.log >&2
  echo "Flashing failed (full log: /tmp/tangcore-flash.log)" >&2
  exit 1
fi
