# Save-state round trip on the SMS RTL core: poke game-path battery bytes,
# save slot 1 through the game menu (115 blocks = 58880 bytes through the
# real savestate_sms engine), power-cycle, reload the game (battery RAM
# comes back from the .sav), load slot 1 (must resume straight into the
# game), save slot 2 -- the two files must be identical. Slot 3 (empty) and
# slot 4 (seeded wrong-game state) are refused cleanly in the menu. Exit
# path everywhere: Back, Back, Resume.
expect-screen "TangCore"
press down
press down
press down
press down
press b
expect-screen "game.sms"
press down
press a
expect-overlay off
expect-core smstang
expect-save-ram 0x00 0xFF
wram-burst 0x000 512 0xA5
expect-file saves/sms/game.sav size 32768
hold select+start+l 400ms
expect-screen "Save states..."
press down
press down
press down
press down
press a
expect-screen "Load state"
press a
expect-screen "Slot 1  (empty)"
press a
expect-screen "Save: Done"
expect-file saves/sms/game.ss1 size 58880
press down
press down
press down
press down
press a
press down
press down
press a
press a
expect-overlay off
power-cycle
expect-screen "TangCore"
press down
press down
press down
press down
press b
expect-screen "game.sms"
press down
press a
expect-overlay off
expect-core smstang
expect-save-ram 0x00 0xA5
expect-save-ram 0x01 0xA6
expect-save-ram 0x1FF 0xA4
expect-save-ram 0x1000 0xFF
hold select+start+l 400ms
expect-screen "Save states..."
press down
press down
press down
press down
press a
press down
press a
expect-screen "Slot 1  (57K)"
press a
expect-overlay off
hold select+start+l 400ms
expect-screen "Save states..."
press down
press down
press down
press down
press a
press a
press down
press a
expect-screen "Save: Done"
expect-file saves/sms/game.ss2 size 58880
expect-files-equal saves/sms/game.ss1 saves/sms/game.ss2
press down
press down
press down
press a
press down
press down
press a
press a
expect-overlay off
hold select+start+l 400ms
expect-screen "Save states..."
press down
press down
press down
press down
press a
press down
press a
press down
press down
press a
expect-screen "Slot is empty"
press down
press a
expect-screen "State is for another"
press down
press a
press down
press a
press a
expect-overlay off
expect-alive 2s
