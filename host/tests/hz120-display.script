# Options -> Display 120 Hz: a game launch programs the 120 Hz build
# (<core>_120hz.bin) instead of the 60 Hz one.
expect-screen "TangCore"
press down
press down
press down
press down
press down
press down
press down
expect-cursor-row 16
press b
expect-screen "Display: 60 Hz (720p)"
press down
press down
press down
press down
press down
press a
expect-screen "Display: 120 Hz (480p)"
expect-screen "Takes effect on next load"
press down
press down
press down
press down
press down
press down
press a
expect-screen "Saved"
# Back sits below the 12-row window: scrolling down to it shows the ^ marker.
press down
expect-screen "<< Back"
expect-screen "^"
press a
expect-screen "TangCore"
# Wrap: Up on the first main-menu item goes to the last.
press up
expect-cursor-row 16
press down
expect-cursor-row 9
press down
press down
press down
press down
press b
expect-screen "cgame.sms"
press down
press a
expect-overlay off
expect-core smstang
expect-core-file "_120hz"
