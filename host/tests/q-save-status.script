# The game menu says what happened to the save. A write that is still inside
# the debounce is flushed by opening the menu, and the menu reports it.
expect-screen "TangCore"
press down
press down
press down
press down
press b
expect-screen "game.sms"
press down
press a
expect-overlay off
expect-core smstang
expect-no-file saves/sms/game.sav
hold select+start+l 400ms
expect-screen "Resume"
expect-screen "Save: none written yet"
press a
expect-overlay off
poke-save 0x10 0x42
hold select+start+l 400ms
expect-screen "Resume"
expect-screen "Saved to card"
expect-file saves/sms/game.sav size 32768
