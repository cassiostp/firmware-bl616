# SNES SA-1 synthetic header (map 0x23, chipset 0x35, SRAM size byte 8 =
# 256 KB BW-RAM) loads: SNES is the second main-menu entry, the game's own
# row is below the file browser's return entry, and a loaded game turns the
# overlay off on the SNES core.
expect-screen "TangCore"
press down
press b
expect-screen "game.smc"
press down
press a
expect-overlay off
expect-core snestang
# Save sizing: the header's SRAM byte sizes 512 blocks, so poking the save
# RAM flushes saves/snes/game.sav with 512 x 512 = 262144 bytes past the
# 2 s debounce (a 512-block dump takes a while: two fetch passes; allow it);
# a power cycle plus reload restores the poked byte.
poke-save 0x10 0x42
expect-file saves/snes/game.sav size 262144 180s
power-cycle
expect-screen "TangCore"
press down
press b
expect-screen "game.smc"
press down
press a
expect-overlay off
expect-save-ram 0x10 0x42
expect-save-ram 0x00 0xFF
