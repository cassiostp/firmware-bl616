# SNES save round trip on the RTL core: a game-path BSRAM burst dirties the
# save, the 2 s debounce flushes it into saves/snes/game.sav (16 blocks =
# 8192 bytes, from the ROM header's SRAM size byte) through the real iosys
# save engine, the SDRAM BSRAM window and the SNES/save bridge arbiter, a
# power cycle wipes the FPGA, and the reload restores the same bytes from
# the file.
expect-screen "TangCore"
press down
press b
expect-screen "game.smc"
press down
press a
expect-overlay off
expect-core snestang
wram-burst 0x000 512 0xA5
expect-file saves/snes/game.sav size 8192
power-cycle
expect-screen "TangCore"
press down
press b
expect-screen "game.smc"
press down
press a
expect-overlay off
expect-save-ram 0x00 0xA5
expect-save-ram 0x01 0xA6
expect-save-ram 0x1FF 0xA4
expect-save-ram 0x1000 0xFF
expect-save-ram 0x2000 0xFF
