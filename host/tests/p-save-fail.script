# A save that cannot be dumped (the core never answers the block request) is
# reported in the game menu with its reason, kept pending, and written once the
# core answers again.
expect-screen "TangCore"
press down
press down
press down
press down
press b
expect-screen "game.sms"
press down
press a
expect-overlay off
expect-core smstang
save-channel off
poke-save 0x10 0x42
hold select+start+l 400ms
expect-screen "Resume"
expect-screen "Save FAILED: no reply"
expect-no-file saves/sms/game.sav
save-channel on
press a
expect-overlay off
expect-file saves/sms/game.sav size 32768
