# File browser: a 30-file dir spans two pages; Up/Down turn the page at the
# edges while the cursor stays visible, ^ more / more v mark the window's
# edges, and both ends wrap. Options' 12 items fit its window: it wraps
# without scrolling.
expect-screen "TangCore"
press down
press down
press down
press down
press b
expect-screen "game01.sms"
expect-screen "more v"
expect-no-screen "^ more"
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
press down
expect-screen "game20.sms"
expect-cursor-row 22
press down
expect-screen "^ more"
expect-screen "game21.sms"
expect-no-screen "more v"
press up
expect-screen "more v"
expect-screen "game20.sms"
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
press up
expect-screen "game01.sms"
# Up on the first item of the first page wraps to the last item.
press up
expect-screen "game30.sms"
expect-screen "^ more"
expect-cursor-row 11
# Down on the last item wraps to the first.
press down
expect-screen "Return to main"
expect-screen "more v"
press b
expect-screen "TangCore"
# Options: all 12 items fit the window, so it never scrolls (no ^ marker),
# and Up on the first item wraps to the last.
press down
press down
press down
press down
press down
press down
press down
expect-cursor-row 16
press b
expect-screen "--- Options ---"
expect-screen "<< Back"
expect-no-screen "^"
press up
expect-cursor-row 20
press down
expect-cursor-row 9
press up
expect-cursor-row 20
press a
expect-screen "TangCore"
