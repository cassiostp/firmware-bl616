# The LCD grid row also appears for the Game Boy Advance: turning it on
# sets video_config bit 15, keeping the default strength (bits 17:16 = 1).
expect-screen "TangCore"
press down
press down
press b
expect-screen "game.gba"
press down
press a
expect-overlay off
expect-core gbatang
# The fake core has no FAST_UART: the 0x15 probes stay silent and the link
# never leaves 2M (16384 ROM + 1024 BIOS + 3 region-3 bytes, one attempt).
expect-baud-max 2000000
expect-baud 2000000
expect-rom-bytes 17411
hold select+start+l 400ms
expect-screen "Resume"
press down
press down
press a
expect-screen "--- Video ---"
expect-screen "LCD grid..."
press down
press down
press down
press a
expect-screen "--- LCD grid ---"
press a
expect-screen "Grid: ON"
expect-video-bit 15 1
expect-video-config 0x1a000
